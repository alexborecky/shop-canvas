		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.29.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.1.2",
		"typescript": "^5.8.3",
